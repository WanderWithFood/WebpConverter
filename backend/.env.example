# Copy to .env for local use. In Stage and Production put these in the host's secrets store instead.
# Stage and Production must use different values for everything below.

NODE_ENV=development            # production on Stage and Production
APP_ENV=development             # development | stage | production
PORT=3000
PUBLIC_URL=http://localhost:3000   # the https address staff use, no trailing slash

DATABASE_URL=postgres://user:password@localhost:5432/wpc
DATABASE_SSL=false              # true when the database requires TLS

# At least 32 random characters. Signs download links, derives API signing secrets, encrypts the break-glass 2FA secret.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
MASTER_SECRET=

# Founders Desk single sign-on (assumed OpenID Connect; adjust src/sso.js after the Founders Desk review)
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_SCOPE=openid email profile

# Local testing only. Ignored when NODE_ENV=production.
DEV_LOGIN=false

TRUST_PROXY=1                   # number of proxies in front (load balancer)
SESSION_HOURS=8
API_RATE_PER_MIN=60             # per system key
USER_RATE_PER_MIN=120           # per signed-in user
CONVERT_CONCURRENCY=2
CONVERT_TIMEOUT_SECONDS=30
MAX_PIXELS=100000000
STORAGE_DIR=./tmp-output        # converted files kept 15 minutes for the signed link, then deleted
